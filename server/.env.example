#  Server 
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

#  CORS 
# Comma-separated list of allowed origins for cross-origin requests.
# Local dev: your Metro/Vite dev server. Production: your Render URL.
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

#  Database (Postgres) 
# Local: postgres://postgres:postgres@localhost:5432/mylifeos
# Render: filled automatically by the Render Postgres add-on
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mylifeos

# Optional: connection pool sizing
DB_POOL_MIN=2
DB_POOL_MAX=10

#  JWT 
# Generate strong secrets:  openssl rand -hex 64
# NEVER commit the real values. Keep them only in .env (gitignored) and Render dashboard.
JWT_ACCESS_SECRET=replace-me-with-64-hex-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-64-hex
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

#  Bcrypt 
BCRYPT_ROUNDS=12

#  Rate limiting 
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

#  Feature flags 
FEATURE_REFERRAL=false