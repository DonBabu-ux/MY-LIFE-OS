# ──────────────────────────────────────────────
# MyLifeOS — Environment Variables
# ──────────────────────────────────────────────
# Copy this to .env and fill in values.
# NEVER commit the real .env file.

# ── App ──────────────────────────────────────
APP_ENV=development            # development | staging | production

# ── Optional Backend ─────────────────────────
# These are only needed if you enable cloud sync.
API_BASE_URL=http://localhost:3000
API_TIMEOUT_MS=10000

# ── Sync ─────────────────────────────────────
SYNC_ENABLED=false
SYNC_INTERVAL_MS=900000        # 15 minutes

# ── Security ─────────────────────────────────
# The SQLCipher key is derived from Android Keystore at runtime.
# No secret key should appear in this file.

# ── OTA Updates ──────────────────────────────
# OtaKit API Key for automated updates
OTAKIT_API=your_otakit_api_key_here
OTAKIT_API_KEY=your_otakit_api_key_here

# ── Logging ──────────────────────────────────
LOG_LEVEL=debug                # error | warn | info | debug
